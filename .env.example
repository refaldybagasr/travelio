# Copy to .env (repo root) to use with docker compose.
# Optional: without a key, search uses Google's shared anonymous quota,
# which can be rate-limited. A free key raises the quota significantly.
GOOGLE_BOOKS_API_KEY=

# Optional: override the Google Books API base URL (e.g. to point at a
# mock/proxy). Defaults to https://www.googleapis.com/books/v1/volumes
# if left blank.
GOOGLE_BOOKS_BASE_URL=
